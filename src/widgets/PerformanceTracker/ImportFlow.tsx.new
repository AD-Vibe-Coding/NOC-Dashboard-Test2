import { useMemo, useState } from "react";
import {
  Alert,
  Badge,
  Box,
  Button,
  Card,
  FileButton,
  Group,
  Select,
  Stack,
  Table,
  Text,
  Title,
  Tooltip,
} from "@mantine/core";
import {
  IconAlertTriangle,
  IconCheck,
  IconCircleCheck,
  IconFileSpreadsheet,
  IconUpload,
  IconX,
} from "@tabler/icons-react";
import {
  executeImport,
  parseWorkbookFile,
  SOURCE_TYPE_DESCRIPTIONS,
  SOURCE_TYPE_LABELS,
  type ImportPlan,
  type ImportResult,
  type ParsedWorkbookFile,
  type SheetPlan,
  type SourceType,
} from "./import";
import { resolveTeamMember } from "./team";

interface Props {
  onComplete: (result: ImportResult) => Promise<void>;
}

type RequiredSource = "tickets" | "calls" | "tasks";

type UploadSlot = {
  sourceType: RequiredSource;
  label: string;
  help: string;
};

type SlotState = {
  file: File | null;
  parsed: ParsedWorkbookFile | null;
  plan: Record<string, SheetPlan>;
  parseError: string | null;
  parsing: boolean;
};

const UPLOAD_SLOTS: UploadSlot[] = [
  {
    sourceType: "tickets",
    label: "Tickets file",
    help: "Upload the workbook/file that contains ticket data only.",
  },
  {
    sourceType: "calls",
    label: "Calls file",
    help: "Upload the workbook/file that contains inbound call data only.",
  },
  {
    sourceType: "tasks",
    label: "Mobility tasks file",
    help: "Upload the workbook/file that contains mobility task data only.",
  },
];

const SOURCE_OPTIONS = [
  { value: "skip", label: "Skip this sheet" },
  { value: "tickets", label: "Tickets" },
  { value: "calls", label: "Inbound Calls" },
  { value: "tasks", label: "Tasks" },
];

function createEmptySlot(): SlotState {
  return {
    file: null,
    parsed: null,
    plan: {},
    parseError: null,
    parsing: false,
  };
}

export function ImportFlow({ onComplete }: Props) {
  const [slots, setSlots] = useState<Record<RequiredSource, SlotState>>({
    tickets: createEmptySlot(),
    calls: createEmptySlot(),
    tasks: createEmptySlot(),
  });
  const [importing, setImporting] = useState(false);
  const [importResult, setImportResult] = useState<ImportResult | null>(null);
  const [importError, setImportError] = useState<string | null>(null);

  async function handleFile(sourceType: RequiredSource, file: File | null) {
    if (!file) return;
    setSlots((prev) => ({
      ...prev,
      [sourceType]: {
        ...prev[sourceType],
        file,
        parsed: null,
        plan: {},
        parseError: null,
        parsing: true,
      },
    }));

    try {
      const parsed = await parseWorkbookFile(file);
      const nextPlan: Record<string, SheetPlan> = {};
      for (const sheet of parsed.sheets) {
        nextPlan[sheet.name] = {
          sheetName: sheet.name,
          sourceType,
          nameColumn: sheet.detectedNameColumn ?? sheet.headers[0] ?? "",
        };
      }
      setSlots((prev) => ({
        ...prev,
        [sourceType]: {
          ...prev[sourceType],
          file,
          parsed,
          plan: nextPlan,
          parseError: null,
          parsing: false,
        },
      }));
    } catch (err) {
      setSlots((prev) => ({
        ...prev,
        [sourceType]: {
          ...prev[sourceType],
          parseError: err instanceof Error ? err.message : String(err),
          parsing: false,
        },
      }));
    }
  }

  function updatePlan(sourceType: RequiredSource, sheetName: string, patch: Partial<SheetPlan>) {
    setSlots((prev) => ({
      ...prev,
      [sourceType]: {
        ...prev[sourceType],
        plan: {
          ...prev[sourceType].plan,
          [sheetName]: { ...prev[sourceType].plan[sheetName], ...patch },
        },
      },
    }));
  }

  function resetAll() {
    setSlots({
      tickets: createEmptySlot(),
      calls: createEmptySlot(),
      tasks: createEmptySlot(),
    });
    setImportResult(null);
    setImportError(null);
  }

  const readySheetCount = useMemo(
    () =>
      Object.values(slots).reduce((count, slot) => {
        if (!slot.parsed) return count;
        return count + slot.parsed.sheets.filter((sheet) => slot.plan[sheet.name]?.sourceType !== "skip").length;
      }, 0),
    [slots],
  );

  async function runImport() {
    setImporting(true);
    setImportError(null);
    try {
      const partials: ImportResult[] = [];
      for (const slot of UPLOAD_SLOTS) {
        const state = slots[slot.sourceType];
        if (!state.file || !state.parsed) continue;
        const planObj: ImportPlan = {
          sheets: state.parsed.sheets.map((sheet) => state.plan[sheet.name]).filter(Boolean),
        };
        if (planObj.sheets.length === 0) continue;
        partials.push(await executeImport(state.file, planObj));
      }

      const combined: ImportResult = {
        fileName: partials.map((item) => item.fileName).join(" + "),
        bySheet: partials.flatMap((item) => item.bySheet),
      };

      setImportResult(combined);
      await onComplete(combined);
    } catch (err) {
      setImportError(err instanceof Error ? err.message : String(err));
    } finally {
      setImporting(false);
    }
  }

  if (importResult) {
    const totalMatched = importResult.bySheet.reduce((n, s) => n + s.matchedRows, 0);
    const totalSkipped = importResult.bySheet.reduce((n, s) => n + s.skippedRows, 0);
    return (
      <Card withBorder radius="md" p="lg">
        <Stack gap="md">
          <Group gap="sm">
            <IconCircleCheck size={28} color="var(--mantine-color-green-5)" />
            <Box>
              <Title order={5}>Import complete</Title>
              <Text size="xs" c="dimmed">
                {importResult.fileName} — {totalMatched} row{totalMatched === 1 ? "" : "s"} imported across {importResult.bySheet.length} sheet{importResult.bySheet.length === 1 ? "" : "s"}
              </Text>
            </Box>
          </Group>

          <Table withTableBorder withColumnBorders highlightOnHover>
            <Table.Thead>
              <Table.Tr>
                <Table.Th>Sheet</Table.Th>
                <Table.Th>Type</Table.Th>
                <Table.Th ta="right">Total</Table.Th>
                <Table.Th ta="right">Matched</Table.Th>
                <Table.Th ta="right">Skipped</Table.Th>
              </Table.Tr>
            </Table.Thead>
            <Table.Tbody>
              {importResult.bySheet.map((s) => (
                <Table.Tr key={`${s.sourceType}-${s.sheetName}`}>
                  <Table.Td>{s.sheetName}</Table.Td>
                  <Table.Td>
                    <Badge size="sm" variant="light">{SOURCE_TYPE_LABELS[s.sourceType]}</Badge>
                  </Table.Td>
                  <Table.Td ta="right" ff="monospace">{s.totalRows}</Table.Td>
                  <Table.Td ta="right" ff="monospace" c="green.4">{s.matchedRows}</Table.Td>
                  <Table.Td ta="right" ff="monospace" c={s.skippedRows > 0 ? "yellow.5" : "dimmed"}>{s.skippedRows}</Table.Td>
                </Table.Tr>
              ))}
            </Table.Tbody>
          </Table>

          {totalSkipped > 0 && (
            <Alert icon={<IconAlertTriangle size={16} />} color="yellow" variant="light" title={`${totalSkipped} row${totalSkipped === 1 ? "" : "s"} skipped`}>
              <Text size="sm" mb={4}>These rows had names not on the locked 14-member roster.</Text>
              {importResult.bySheet.flatMap((s) =>
                s.skippedNames.length > 0
                  ? [
                      <Text key={`${s.sourceType}-${s.sheetName}`} size="xs" c="dimmed">
                        <b>{s.sheetName}:</b> {s.skippedNames.slice(0, 8).join(", ")}
                        {s.skippedNames.length > 8 ? `, +${s.skippedNames.length - 8} more` : ""}
                      </Text>,
                    ]
                  : [],
              )}
            </Alert>
          )}

          <Group justify="flex-end">
            <Button variant="default" onClick={resetAll}>Import another set of files</Button>
          </Group>
        </Stack>
      </Card>
    );
  }

  return (
    <Stack gap="md">
      <Card withBorder radius="md" p="xl">
        <Stack gap="xs">
          <Group gap="sm">
            <IconFileSpreadsheet size={28} color="var(--mantine-color-green-5)" />
            <Title order={4}>Upload separate source files</Title>
          </Group>
          <Text size="sm" c="dimmed">
            Upload tickets, calls, and mobility tasks as separate files. Each file can still contain one or more sheets, but each upload is now tied to a single source type.
          </Text>
        </Stack>
      </Card>

      {UPLOAD_SLOTS.map((slot) => {
        const state = slots[slot.sourceType];
        return (
          <Card key={slot.sourceType} withBorder radius="md" p="lg">
            <Stack gap="md">
              <Group justify="space-between" align="flex-start">
                <Box>
                  <Title order={5}>{slot.label}</Title>
                  <Text size="sm" c="dimmed">{slot.help}</Text>
                </Box>
                <FileButton onChange={(file) => handleFile(slot.sourceType, file)} accept=".xlsx,.xls">
                  {(props) => (
                    <Button {...props} leftSection={<IconUpload size={16} />} loading={state.parsing}>
                      {state.file ? "Replace file" : "Upload file"}
                    </Button>
                  )}
                </FileButton>
              </Group>

              {state.file && (
                <Group gap="xs">
                  <Badge variant="light">{SOURCE_TYPE_LABELS[slot.sourceType]}</Badge>
                  <Text size="sm">{state.file.name}</Text>
                </Group>
              )}

              {state.parseError && (
                <Alert color="red" icon={<IconX size={16} />} variant="light">
                  {state.parseError}
                </Alert>
              )}

              {state.parsed?.sheets.map((sheet) => (
                <SheetReviewCard
                  key={`${slot.sourceType}-${sheet.name}`}
                  forcedSourceType={slot.sourceType}
                  info={sheet}
                  plan={state.plan[sheet.name]}
                  onPlanChange={(patch) => updatePlan(slot.sourceType, sheet.name, patch)}
                />
              ))}
            </Stack>
          </Card>
        );
      })}

      {importError && (
        <Alert color="red" icon={<IconX size={16} />} variant="light">
          {importError}
        </Alert>
      )}

      <Group justify="flex-end">
        <Button variant="subtle" onClick={resetAll} disabled={importing}>Cancel</Button>
        <Button
          size="sm"
          color="green"
          leftSection={<IconCheck size={14} />}
          loading={importing}
          disabled={readySheetCount === 0}
          onClick={runImport}
        >
          Import {readySheetCount} sheet{readySheetCount === 1 ? "" : "s"}
        </Button>
      </Group>
    </Stack>
  );
}

function SheetReviewCard({
  info,
  plan,
  forcedSourceType,
  onPlanChange,
}: {
  info: ParsedWorkbookFile["sheets"][number];
  plan: SheetPlan;
  forcedSourceType: RequiredSource;
  onPlanChange: (patch: Partial<SheetPlan>) => void;
}) {
  const isSkipped = plan?.sourceType === "skip";
  const effectiveSourceType = (plan?.sourceType === "skip" ? forcedSourceType : plan?.sourceType ?? forcedSourceType) as RequiredSource;

  return (
    <Card withBorder radius="md" p="md" style={{ opacity: isSkipped ? 0.6 : 1 }}>
      <Stack gap="sm">
        <Group justify="space-between" wrap="nowrap">
          <Group gap="xs" wrap="nowrap" style={{ minWidth: 0 }}>
            <Text fw={600} truncate>{info.name}</Text>
            <Badge size="xs" variant="default">{info.totalRows} row{info.totalRows === 1 ? "" : "s"}</Badge>
            {info.detectedType !== "unknown" && (
              <Tooltip label={SOURCE_TYPE_DESCRIPTIONS[effectiveSourceType]}>
                <Badge size="xs" color="green" variant="light">detected: {SOURCE_TYPE_LABELS[info.detectedType as SourceType]}</Badge>
              </Tooltip>
            )}
          </Group>
          <Badge
            size="sm"
            color={
              info.projectedMatches === info.totalRows && info.projectedMatches > 0
                ? "green"
                : info.projectedMatches > 0
                  ? "yellow"
                  : "red"
            }
            variant="light"
          >
            ~{info.projectedMatches} / {info.totalRows} match roster
          </Badge>
        </Group>

        <Group grow gap="sm">
          <Select
            label="Import action"
            size="xs"
            data={SOURCE_OPTIONS.filter((option) => option.value === "skip" || option.value === forcedSourceType)}
            value={plan?.sourceType ?? forcedSourceType}
            onChange={(value) => onPlanChange({ sourceType: (value ?? forcedSourceType) as SourceType | "skip" })}
            allowDeselect={false}
          />
          <Select
            label="Agent name column"
            size="xs"
            data={info.headers.filter(Boolean).map((header) => ({ value: header, label: header }))}
            value={plan?.nameColumn ?? ""}
            onChange={(value) => onPlanChange({ nameColumn: value ?? "" })}
            disabled={isSkipped}
            searchable
            allowDeselect={false}
          />
        </Group>

        {!isSkipped && info.preview.length > 0 && (
          <Box style={{ overflowX: "auto" }}>
            <Table withTableBorder withColumnBorders striped fz="xs" styles={{ td: { whiteSpace: "nowrap" } }}>
              <Table.Thead>
                <Table.Tr>
                  {info.headers.slice(0, 8).map((header) => (
                    <Table.Th
                      key={header}
                      style={{
                        background: header === plan?.nameColumn ? "var(--mantine-color-green-9)" : undefined,
                      }}
                    >
                      {header || "(blank)"}
                    </Table.Th>
                  ))}
                  {info.headers.length > 8 && <Table.Th c="dimmed">+{info.headers.length - 8} more cols</Table.Th>}
                </Table.Tr>
              </Table.Thead>
              <Table.Tbody>
                {info.preview.slice(0, 3).map((row, index) => (
                  <Table.Tr key={index}>
                    {info.headers.slice(0, 8).map((header) => {
                      const isNameCol = header === plan?.nameColumn;
                      const value = row[header];
                      const canonical = isNameCol && value ? resolveTeamMember(String(value)) : null;
                      return (
                        <Table.Td
                          key={header}
                          style={{
                            background:
                              isNameCol && !canonical && value
                                ? "var(--mantine-color-yellow-9)"
                                : isNameCol && canonical
                                  ? "var(--mantine-color-green-9)"
                                  : undefined,
                            opacity: isNameCol && !canonical && value ? 0.7 : 1,
                          }}
                        >
                          {value == null || value === "" ? (
                            <Text size="xs" c="dimmed" fs="italic">—</Text>
                          ) : (
                            <Text size="xs">
                              {String(value)}
                              {isNameCol && canonical && canonical !== String(value) && (
                                <Text component="span" c="green.4" ml={4} fz="xs">→ {canonical}</Text>
                              )}
                            </Text>
                          )}
                        </Table.Td>
                      );
                    })}
                    {info.headers.length > 8 && <Table.Td />}
                  </Table.Tr>
                ))}
              </Table.Tbody>
            </Table>
          </Box>
        )}
      </Stack>
    </Card>
  );
}
