{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ai/chat.ts": { "maxDuration": 60 },
    "api/confluence/extract-images.ts": { "maxDuration": 60 },
    "api/zoom/queue.ts": { "maxDuration": 30 },
    "api/access-control.ts": { "maxDuration": 10 },
    "api/auth/callback.ts": { "maxDuration": 15 },
    "api/auth/dev-login.ts": { "maxDuration": 10 },
    "api/app-usage/sync-google-sheet.ts": { "maxDuration": 30 },
    "api/app-usage/weekly-sync.ts": { "maxDuration": 30 },
    "api/work-allotment/generate.ts": { "maxDuration": 30 },
    "api/work-allotment/post.ts": { "maxDuration": 30 },
    "api/work-allotment/cron.ts": { "maxDuration": 30 },
    "api/reminders/meetings/sync.ts": { "maxDuration": 30 },
    "api/reminders/meetings/plan.ts": { "maxDuration": 30 },
    "api/reminders/meetings/dispatch.ts": { "maxDuration": 30 },
    "api/reminders/meetings/reconcile.ts": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/app-usage/weekly-sync",
      "schedule": "0 12 * * 5"
    },
    {
      "path": "/api/work-allotment/cron?action=generate",
      "schedule": "10 10 * * *"
    },
    {
      "path": "/api/work-allotment/cron?action=post-due",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/reminders/meetings/sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/reminders/meetings/plan",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/reminders/meetings/dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/reminders/meetings/reconcile",
      "schedule": "*/5 * * * *"
    }
  ]
}

